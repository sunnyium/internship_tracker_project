# Copy this file to .env and fill in your real values. Never commit .env to git.

# Required for AI double-check classification - free, no credit card needed.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Email notifications. Use a Gmail "app password", NOT your real password:
# https://myaccount.google.com/apppasswords
# Enter the password without the spaces Google displays it with.
# The sending account authenticates itself, so FROM and the app password must
# belong to the same mailbox.
EMAIL_FROM_ADDRESS=
EMAIL_APP_PASSWORD=

# Where digests are delivered. Leave blank to send to EMAIL_FROM_ADDRESS.
EMAIL_TO_ADDRESS=

# The ntfy push topic is NOT here - it isn't a secret in the credential sense
# and lives in config/config.yaml. Note it is public to anyone who knows the
# name, so pick something unguessable.
